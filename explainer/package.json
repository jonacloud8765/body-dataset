{
  "name": "calm-but-ready-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion implementation of the 'Calm, But Ready' animated explainer",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "still": "remotion still src/index.ts",
    "render": "remotion render src/index.ts CalmButReady out/calm-but-ready.mp4",
    "render:preview": "remotion render src/index.ts CalmButReady out/calm-but-ready-540p.mp4 --scale=0.5"
  },
  "dependencies": {
    "@remotion/cli": "4.0.529",
    "@remotion/google-fonts": "4.0.529",
    "@remotion/noise": "4.0.529",
    "@remotion/paths": "4.0.529",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "remotion": "4.0.529"
  },
  "devDependencies": {
    "@types/react": "19.1.8",
    "typescript": "5.8.3"
  }
}
